<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>selenium</groupId>
  <artifactId>MobileAutomation</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>MobileAutomation</name>
  <description>Appium-based mobile test automation framework (Android + iOS)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>11</java.version>
    <appium.version>9.4.0</appium.version>
    <selenium.version>4.43.0</selenium.version>
    <testng.version>7.11.0</testng.version>
    <cucumber.version>7.22.1</cucumber.version>
    <!-- Default suite — override with -Pandroid / -Pios / -Pregression -->
    <testNGSuite>src/test/suites/androidTestSuite.xml</testNGSuite>
  </properties>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${testNGSuite}</suiteXmlFile>
          </suiteXmlFiles>
          <!-- Forward CI env vars as JVM system properties so ConfigReader picks them up -->
          <systemPropertyVariables>
            <SAUCEDEMO_USERNAME>${env.SAUCEDEMO_USERNAME}</SAUCEDEMO_USERNAME>
            <SAUCEDEMO_PASSWORD>${env.SAUCEDEMO_PASSWORD}</SAUCEDEMO_PASSWORD>
            <TRUDOC_PHONE>${env.TRUDOC_PHONE}</TRUDOC_PHONE>
            <TRUDOC_PASSWORD>${env.TRUDOC_PASSWORD}</TRUDOC_PASSWORD>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- ── Appium (Android + iOS) ───────────────────────────────────── -->
    <dependency>
      <groupId>io.appium</groupId>
      <artifactId>java-client</artifactId>
      <version>${appium.version}</version>
    </dependency>

    <!-- ── Selenium (pinned; Appium 9.x requires Selenium 4) ────────── -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <!-- ── Test runner ──────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ── BDD (retained; not yet wired to tests) ───────────────────── -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-core</artifactId>
      <version>${cucumber.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-testng</artifactId>
      <version>${cucumber.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
    </dependency>

    <!-- ── Data utilities ──────────────────────────────────────────── -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
    </dependency>
    <dependency>
      <groupId>com.opencsv</groupId>
      <artifactId>opencsv</artifactId>
      <version>5.10</version>
    </dependency>
    <dependency>
      <groupId>com.googlecode.json-simple</groupId>
      <artifactId>json-simple</artifactId>
      <version>1.1.1</version>
    </dependency>
    <!-- Replaces abandoned com.github.javafaker:javafaker -->
    <dependency>
      <groupId>net.datafaker</groupId>
      <artifactId>datafaker</artifactId>
      <version>2.4.3</version>
    </dependency>
  </dependencies>

  <profiles>
    <!-- mvn test -Pandroid  → runs androidTestSuite.xml -->
    <profile>
      <id>android</id>
      <properties>
        <testNGSuite>src/test/suites/androidTestSuite.xml</testNGSuite>
      </properties>
    </profile>

    <!-- mvn test -Pios  → runs iosTestSuite.xml -->
    <profile>
      <id>ios</id>
      <properties>
        <testNGSuite>src/test/suites/iosTestSuite.xml</testNGSuite>
      </properties>
    </profile>

    <!-- mvn test -Pregression  → runs regressionSuite.xml (TruDoc) -->
    <profile>
      <id>regression</id>
      <properties>
        <testNGSuite>src/test/suites/regressionSuite.xml</testNGSuite>
      </properties>
    </profile>
  </profiles>
</project>
